---
import { getTours, getSettings, getWording, fill } from '../lib/content';
const site = await getSettings();
const tours = await getTours();
const W = (await getWording()).enquiry as Record<string, any>;
interface Props { kind?: 'tour' | 'military' | 'relative' }
const { kind = 'tour' } = Astro.props;
const opts = [...tours.map((t) => t.next?.label && t.next.start ? `${t.next.label} (${t.next.dates})` : t.name), ...W.extra_tour_options];
const msg = { tour: W.message_tour, military: W.message_military, relative: W.message_relative }[kind];
const texts = { error: W.error, sent: fill(W.sent, { email: site.email }), subject_tour: W.subject_tour, subject_military: W.subject_military, subject_relative: W.subject_relative };
---
<form class="enquiry" data-kind={kind} data-to={site.email} data-texts={JSON.stringify(texts)} novalidate>
  <div class="row2">
    <div class="field"><label for="name">{W.name}</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
    <div class="field"><label for="email">{W.email}</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div class="row2">
    <div class="field"><label for="tel">{W.phone}</label><input id="tel" name="tel" type="tel" autocomplete="tel" /></div>
    {kind === 'military'
      ? <div class="field"><label for="unit">{W.unit}</label><input id="unit" name="unit" type="text" /></div>
      : <div class="field"><label for="tour">{W.tour}</label><select id="tour" name="tour">{opts.map((o) => <option>{o}</option>)}</select></div>}
  </div>
  {kind === 'tour' && (
    <div class="row2">
      <div class="field"><label for="people">{W.people}</label><input id="people" name="people" type="number" min="1" value="1" /></div>
      <div class="field"><label for="room">{W.room}</label><select id="room" name="room">{W.room_options.map((o: string) => <option>{o}</option>)}</select></div>
    </div>
  )}
  {kind === 'military' && (
    <div class="row2">
      <div class="field"><label for="size">{W.group_size}</label><input id="size" name="size" type="number" min="1" /></div>
      <div class="field"><label for="when">{W.preferred_dates}</label><input id="when" name="when" type="text" placeholder={W.preferred_dates_placeholder} /></div>
    </div>
  )}
  {kind === 'relative' && (
    <>
      <div class="row2">
        <div class="field"><label for="rname">{W.relative_name}</label><input id="rname" name="rname" type="text" /></div>
        <div class="field"><label for="runit">{W.relative_unit}</label><input id="runit" name="runit" type="text" placeholder={W.relative_unit_placeholder} /></div>
      </div>
      <div class="field"><label for="rnum">{W.relative_details}</label><input id="rnum" name="rnum" type="text" /></div>
    </>
  )}
  <div class="field"><label for="msg">{msg}</label><textarea id="msg" name="msg" rows="5"></textarea></div>
  <button class="btn" type="submit">{W.submit}</button>
  <p class="muted form-status" role="status" style="font-size:0.95rem;margin-top:12px">{fill(W.help, { email: site.email })}</p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('form.enquiry').forEach((f) => {
    const T = JSON.parse(f.dataset.texts || '{}');
    const sel = f.querySelector<HTMLSelectElement>('#tour');
    const want = new URLSearchParams(location.search).get('tour');
    if (sel && want) { const o = [...sel.options].find((x) => x.text.startsWith(want)); if (o) sel.value = o.text; }
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = f.querySelector<HTMLInputElement>('#name')!; const email = f.querySelector<HTMLInputElement>('#email')!;
      const st = f.querySelector('.form-status')!;
      if (!name.value.trim() || !email.validity.valid || !email.value) { st.textContent = T.error; (name.value.trim() ? email : name).focus(); return; }
      const lines: string[] = [];
      f.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((el) => {
        const lab = f.querySelector(`label[for="${el.id}"]`)?.textContent || el.name;
        if (el.value) lines.push(`${lab}: ${el.value}`);
      });
      const kind = f.dataset.kind;
      const subj = kind === 'military' ? T.subject_military : kind === 'relative' ? T.subject_relative : String(T.subject_tour).replace('{tour}', sel?.value ?? '');
      location.href = `mailto:${f.dataset.to}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(lines.join('\n'))}`;
      st.textContent = T.sent;
    });
  });
</script>
