---
import { metaFor } from '../lib/images';
interface Props { id: string; alt: string; sizes?: string; eager?: boolean; class?: string; cms?: Record<string, string> }
const { id, alt, sizes = '(max-width: 800px) 100vw, 50vw', eager = false, class: cls, cms = {} } = Astro.props;
const m = metaFor(id);
let src: string, srcset: string | undefined, w: number | undefined, h: number | undefined;
if (m) {
  srcset = m.sizes.map((s) => `/img/${id}-${s}.webp ${Math.min(s, m.w)}w`).join(', ');
  const def = m.sizes.includes(1280) ? 1280 : m.sizes[m.sizes.length - 1];
  w = Math.min(def, m.w); h = Math.round((m.h * w) / m.w); src = `/img/${id}-${def}.webp`;
} else {
  // A fresh CMS upload not yet optimised (dev server running): show the original.
  src = id;
}
---
<img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} width={w} height={h} alt={alt} class={cls}
  loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" {...cms} />
