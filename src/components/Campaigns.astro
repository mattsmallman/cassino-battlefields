---
import Img from './Img.astro';
import { getTours, getWording, fill } from '../lib/content';
const tours = await getTours();
const W = (await getWording()).departures;
---
<div class="campaigns">
  {tours.map((t) => (
    <a class="campaign" href={`/${t.slug}/`}>
      {t.hero ? (
        <div class="ph"><Img id={t.hero} alt={t.heroCap || t.name} sizes="(max-width: 600px) 100vw, 33vw" /><span class="coord">{t.coords}</span></div>
      ) : (
        <div class="ph blank"><span>{t.name.replace(/^The /, '')}</span><span class="coord">{t.coords}</span></div>
      )}
      <div class="period">{t.period}<span class="days">{fill(W.days, { days: t.days })}</span></div>
      <h3>{t.name}</h3>
      <p>{t.short}</p>
    </a>
  ))}
</div>
