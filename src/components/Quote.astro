---
interface Props { t: { quote: string; name: string; from: string }; max?: number }
const { t, max } = Astro.props;
let q = t.quote;
if (max && q.length > max) { const cut = q.slice(0, max); q = cut.slice(0, cut.lastIndexOf('. ') + 1) || cut + '…'; }
---
<blockquote class="pull"><p>‘{q}’</p><footer><b>{t.name}</b>{t.from && <>, {t.from}</>}</footer></blockquote>
