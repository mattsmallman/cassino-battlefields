---
import { cms } from '../lib/cms';
import { trimQuote } from '../lib/format';
interface Props { t: { id?: string; quote: string; name: string; from: string }; max?: number }
const { t, max } = Astro.props;
const src = t.id ? `testimonials:${t.id}` : '';
const b = (f: string, fmt: 'text' | 'quote' = 'text', vars?: Record<string, number>) => (src ? cms(src, f, fmt, vars) : {});
---
<blockquote class="pull"><p {...b('quote', 'quote', max ? { max } : undefined)}>‘{trimQuote(t.quote, max)}’</p><footer><b {...b('name')}>{t.name}</b>{t.from && <>, <span {...b('from')}>{t.from}</span></>}</footer></blockquote>
