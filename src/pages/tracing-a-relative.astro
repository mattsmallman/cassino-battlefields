---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Quote from '../components/Quote.astro';
import Enquiry from '../components/Enquiry.astro';
import { getPage, getQuotesById, md, imageRef } from '../lib/content';
const P = await getPage('tracing');
const [quote] = P.quote ? await getQuotesById([P.quote]) : [];
const fam = await getQuotesById(P.family_quotes);
const img = imageRef(P.image, P.image_caption);
---
<Base title={P.title || P.heading} description={P.seo_description}>
  <section class="band"><div class="wrap split">
    <figure><Img id={img.id} alt={img.cap} sizes="(max-width: 860px) 100vw, 40vw" eager /><figcaption>{img.cap}</figcaption></figure>
    <div>
      <h1>{P.heading}</h1>
      {P.lede && <p class="lede">{P.lede}</p>}
      {P.body && <Fragment set:html={md(P.body)} />}
      {quote && <Quote t={quote} />}
    </div>
  </div></section>
  <section class="band alt"><div class="wrap split">
    <div>
      <h2>{P.helps_heading}</h2>
      {P.helps && <Fragment set:html={md(P.helps)} />}
    </div>
    <div><h2>{P.form_heading}</h2><Enquiry kind="relative" /></div>
  </div></section>
  {fam.length > 0 && (
    <section class="band dark"><div class="wrap"><div class="section-head"><h2>{P.families_heading}</h2></div>
      <div class="quotes3">{fam.map((q) => <Quote t={q} />)}</div></div></section>
  )}
</Base>
