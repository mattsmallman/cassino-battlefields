---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { getFaqs, md } from '../lib/content';
const f = await getFaqs();
---
<Base title="FAQs" description={f.seo_description}>
  <section class="band"><div class="wrap split">
    <div>
      <h1>{f.heading}</h1>
      {f.img && <figure style="margin-top:24px"><Img id={f.img.id} alt={f.img.cap} sizes="(max-width: 860px) 100vw, 40vw" /><figcaption>{f.img.cap}</figcaption></figure>}
    </div>
    <div class="faq">
      {f.faqs.map((q, i) => (
        <details open={i === 0}><summary>{q.question}</summary><div class="a" set:html={md(q.answer)} /></details>
      ))}
    </div>
  </div></section>
</Base>
