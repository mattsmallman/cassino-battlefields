---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Gallery from '../components/Gallery.astro';
import Quote from '../components/Quote.astro';
import { tours, gbp } from '../lib/tours';
import G from '../data/galleries.json';
import T from '../data/testimonials.json';
export function getStaticPaths() { return tours.map((t) => ({ params: { tour: t.slug } })); }
const t = tours.find((x) => x.slug === Astro.params.tour)!;
const gal = t.gallery ? (G as any)[t.gallery] as { id: string; cap: string }[] : [];
const used = new Set([t.hero, ...t.images.map((i) => i.id)]);
const strip = gal.filter((g) => !used.has(g.id)).slice(0, 10);
const quotes = T.filter((q) => q.tours.includes(t.slug) && q.quote.length < 520).slice(0, 3);
// spread the itinerary photos evenly through the days
const perDay: { id: string; cap: string }[][] = t.itinerary.map(() => []);
t.images.forEach((im, k) => { if (!perDay.length) return; const d = Math.min(perDay.length - 1, Math.floor(((k + 1) * perDay.length) / (t.images.length + 1))); perDay[d].push(im); });
const byDay = (i: number) => perDay[i] ?? [];
const enquire = `/contact/?tour=${encodeURIComponent(t.next?.label ?? t.name)}`;
---
<Base title={`${t.name} battlefield tour`} description={`${t.name}, ${t.period}: a ${t.days}-day battlefield study led by Frank de Planta. ${t.short}.`} image={t.hero}>
  {t.hero ? (
    <section class="hero short mapframe">
      <Img id={t.hero} alt={t.heroCap || t.name} sizes="100vw" eager />
      <span class="coord tl">{t.coords}</span>
      {t.heroCap && <span class="coord br">{t.heroCap}</span>}
      <div class="wrap"><p style="font-family:var(--sans);font-weight:600;margin:0 0 8px">{t.period}</p><h1>{t.name}</h1><p>{t.short}</p></div>
    </section>
  ) : (
    <section class="hero plain mapframe">
      <span class="coord tl">{t.coords}</span>
      <div class="wrap"><p style="font-family:var(--sans);font-weight:600;margin:0 0 8px">{t.period}</p><h1>{t.name}</h1><p>{t.short}</p></div>
    </section>
  )}

  <section class="band">
    <div class="wrap tour-grid">
      <div>
        <p class="lede">{t.summary}</p>
        {t.itinerary.length > 0 ? (
          <>
            <h2 style="margin-top:48px">Day by day</h2>
            <ol class="days">
              {t.itinerary.map((d, i) => (
                <li class="day">
                  <div class="dn">Day <b>{d.n}</b></div>
                  <div>
                    <ul class="stands">{d.items.map((s) => <li>{s}</li>)}</ul>
                    {byDay(i).map((im) => (
                      <figure class="inline-fig"><Img id={im.id} alt={im.cap} sizes="(max-width: 960px) 100vw, 60vw" /><figcaption>{im.cap}</figcaption></figure>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <p>Frank will send the full itinerary with your booking form. <a href={enquire}>Ask for the itinerary</a></p>
        )}
        <h2 style="margin-top:48px">What’s included</h2>
        <ul>
          <li>Minibus or coach from the airport, staying with the group throughout</li>
          <li>{t.price?.basis === 'half board' ? 'Hotel accommodation with breakfast and evening meal' : 'En-suite hotel rooms with continental breakfast'}</li>
          <li>A briefing pack for each room booked, covering the background to the battles</li>
          <li>Frank de Planta as your guide on every day of the study</li>
        </ul>
        <h3>Not included</h3>
        <p>{t.excludes}, and travel insurance (which you must have to travel).</p>
      </div>
      <aside class="facts" aria-label="Key facts">
        <dl>
          {t.next && <><dt>Next dates</dt><dd>{t.next.dates}</dd></>}
          <dt>Duration</dt><dd>{t.days} days</dd>
          <dt>Fly into</dt><dd>{t.arrive}</dd>
          {t.depart !== t.arrive.split(' ')[0] && <><dt>Fly home from</dt><dd>{t.depart}</dd></>}
          {t.base && <><dt>Based in</dt><dd>{t.base}</dd></>}
          <dt>Group size</dt><dd>8 to 50</dd>
          <dt>Walking</dt><dd>Light; the minibus is always close by</dd>
          <dt>Deposit</dt><dd>£80 per person</dd>
        </dl>
        {t.price ? (
          <>
            <div class="price">{gbp(t.price.twin)}</div>
            <div>per person sharing a twin or double, {t.price.basis}</div>
            <div style="margin:6px 0 18px" class="muted">{gbp(t.price.single)} in a single room</div>
          </>
        ) : <p style="margin-bottom:18px">Dates and prices on request</p>}
        <a class="btn" href={enquire}>{t.next?.start ? 'Book a place' : 'Register interest'}</a>
        <p class="note">Already in Italy, or travelling with your own transport? Ask about the reduced price.</p>
      </aside>
    </div>
  </section>

  {quotes.length > 0 && (
    <section class="band dark">
      <div class="wrap"><div class="section-head"><h2>From past {t.name.replace(/^The /, '')} groups</h2><a href="/testimonials/" style="color:#fff">All testimonials</a></div>
      <div class="quotes3">{quotes.map((q) => <Quote t={q} />)}</div></div>
    </section>
  )}

  {strip.length > 0 && (
    <section class="band">
      <div class="wrap"><div class="section-head"><h2>{t.name} in pictures</h2><a href={`/gallery/#${t.gallery}`}>Full {t.name.replace(/^The /, '')} gallery</a></div>
      <Gallery items={strip} strip /></div>
    </section>
  )}
</Base>
