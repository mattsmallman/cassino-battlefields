---
import Base from '../layouts/Base.astro';
import { getBooks, getGalleries } from '../lib/content';
const lists = await getBooks();
const { G } = await getGalleries();
const total = (s: string) => lists.find((l) => l.slug === s)?.books.length ?? 0;
import Gallery from '../components/Gallery.astro';
---
<Base title="Reading list" description="Frank de Planta’s reading lists for the Italian Campaign: general histories and memoirs, and regimental and corps histories.">
  <section class="band"><div class="wrap">
    <h1>Reading list</h1>
    <p class="lede">The books Frank recommends before you travel: {total('general')} general histories and memoirs, and {total('regiments')} regimental and corps histories for anyone following a particular unit.</p>
    <div class="field" style="max-width:420px"><label for="q">Search by title, author or regiment</label><input id="q" type="search" placeholder="e.g. Gurkha, Majdalany, Anzio" autocomplete="off" /></div>
    <div style="margin:32px 0 32px"><Gallery items={[...(G['general-reading-list'] ?? []), ...(G['regiment-core'] ?? [])]} strip /></div>
    <nav class="chips" aria-label="Lists">{lists.map((l) => <a href={`#${l.slug}`}>{l.title}</a>)}</nav>
  </div></section>
  {lists.map((l, i) => (
    <section class={`band${i % 2 ? '' : ' alt'}`} id={l.slug}><div class="wrap">
      <h2>{l.title}</h2>
      <ul class="books">{l.books.map((b) => <li><cite>{b.title}</cite><span class="by">{b.author}</span></li>)}</ul>
    </div></section>
  ))}
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    q.addEventListener('input', () => { const v = q.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('.books li').forEach((li) => { li.hidden = !!v && !li.textContent!.toLowerCase().includes(v); }); });
  </script>
</Base>
