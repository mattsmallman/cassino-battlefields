---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Gallery from '../components/Gallery.astro';
import { getGalleries } from '../lib/content';
const { G } = await getGalleries();
const [lead, ...rest] = G.about ?? [];
---
<Base title="About Frank de Planta" description="Frank de Planta, former Royal Anglian Regiment officer and author of A Walking Tour of Italy’s WWII Battlefields, has led battlefield studies of the Italian Campaign for more than fifteen years." image={lead.id}>
  <section class="band"><div class="wrap split">
    <figure><Img id={lead.id} alt={lead.cap} sizes="(max-width: 860px) 100vw, 40vw" eager /><figcaption>{lead.cap}</figcaption></figure>
    <div>
      <h1>Frank de Planta</h1>
      <p class="lede">Frank has been fascinated by military history since childhood. He read Modern History at King’s College London, was commissioned into the Royal Anglian Regiment in 1984, and later commanded East Midlands Officers’ Training Corps in the Territorial Army.</p>
      <p>Fred Majdalany’s first-hand account of Cassino started a lifelong interest in that controversial series of battles, and from there in Anzio, which is bound up with it. He has since run battlefield studies in Spain, France and Italy.</p>
      <p>Each year brings a new research project, often walked on the ground before it becomes part of a tour:</p>
      <ul>
        <li><b>2010</b> Researched for Wall to Wall, producers of the BBC’s <em>Who Do You Think You Are?</em></li>
        <li><b>2011</b> The route of 1/6th East Surreys from the fall of Rome to the capture of Forlì</li>
        <li><b>2012</b> The Battle of Salerno, now a study in its own right</li>
        <li><b>2013</b> 1st Canadian Infantry Division’s assault on the Hitler Line, 23 May 1944</li>
        <li><b>2014</b> 128 (Hampshire) Infantry Brigade’s crossing of the Garigliano, 19 January 1944</li>
        <li><b>2015–16</b> 234 Infantry Brigade’s defence of Leros, ‘Churchill’s Folly’</li>
        <li><b>2017–18</b> Eighth Army’s battle for the Gothic Line, August–September 1944</li>
        <li><b>2019</b> 5th Canadian Armoured Division at the River Melfa, where Major John Mahony won the Victoria Cross</li>
        <li><b>2020–22</b> Writing the three-volume <em>A Walking Tour of Italy’s WWII Battlefields</em>, from Salerno to Rome</li>
        <li><b>2023</b> US Fifth Army’s advance to Florence and the winter of 1944–45 in the Apennines</li>
      </ul>
      <a class="btn" href="/contact/">Contact Frank</a>
    </div>
  </div></section>
  <section class="band alt"><div class="wrap"><div class="section-head"><h2>On the ground</h2></div><Gallery items={rest} /></div></section>
</Base>
