---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Gallery from '../components/Gallery.astro';
import { getGalleries, getAbout, md, mdInline } from '../lib/content';
const a = await getAbout();
const { G } = await getGalleries();
const rest = a.gallery ? G[a.gallery] ?? [] : [];
---
<Base title={`About ${a.heading}`} description={a.seo_description} image={a.lead.id}>
  <section class="band"><div class="wrap split">
    <figure><Img id={a.lead.id} alt={a.lead.cap} sizes="(max-width: 860px) 100vw, 40vw" eager /><figcaption>{a.lead.cap}</figcaption></figure>
    <div>
      <h1>{a.heading}</h1>
      <p class="lede">{a.lede}</p>
      {a.body && <Fragment set:html={md(a.body)} />}
      {a.research.length > 0 && (
        <ul>{a.research.map((r) => <li><b>{r.year}</b> <Fragment set:html={mdInline(r.text)} /></li>)}</ul>
      )}
      <a class="btn" href="/contact/">Contact Frank</a>
    </div>
  </div></section>
  {rest.length > 0 && (
    <section class="band alt"><div class="wrap"><div class="section-head"><h2>{a.gallery_heading || 'Photographs'}</h2></div><Gallery items={rest} /></div></section>
  )}
</Base>
