---
import Base from '../layouts/Base.astro';
import Enquiry from '../components/Enquiry.astro';
---
<Base title="Contact and booking" description="Book a place or ask Frank de Planta a question about Cassino Battlefields tours. Phone, email and post details.">
  <section class="band"><div class="wrap split">
    <div>
      <h1>Book or ask a question</h1>
      <p class="lede">Tell Frank which tour you’re interested in and he’ll send a booking form, or answer any question about the battles, the itinerary or a relative who served.</p>
      <h3 style="margin-top:32px">Email</h3><p><a href="mailto:enquiries@cassinobattlefields.co.uk">enquiries@cassinobattlefields.co.uk</a></p>
      <h3>Telephone</h3><p><a href="tel:+441347811104">+44 (0)1347 811104</a><br /><a href="tel:+447768278464">+44 (0)7768 278464</a></p>
      <h3>Post</h3><p>West Winds, The Gowans<br />Sutton on the Forest<br />York YO61 1DL</p>
      <h3>Facebook</h3><p><a href="https://www.facebook.com/frank.deplanta" rel="noopener">Frank de Planta</a></p>
    </div>
    <div><h2>Send an enquiry</h2><Enquiry /></div>
  </div></section>
</Base>
