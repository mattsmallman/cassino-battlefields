---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Departures from '../components/Departures.astro';
import Campaigns from '../components/Campaigns.astro';
import Quote from '../components/Quote.astro';
import Gallery from '../components/Gallery.astro';
import { getTestimonials, getGalleries, getPage, getSettings, getQuotesById, fill, md, mdInline, imageRef } from '../lib/content';
const P = await getPage('home');
const site = await getSettings();
const T = await getTestimonials();
const { G } = await getGalleries();
const quotes = await getQuotesById(P.featured_quotes);
const [unitQuote] = P.military_quote ? await getQuotesById([P.military_quote]) : [];
const hero = imageRef(P.hero_image, P.hero_alt);
const strip = P.archive_gallery ? G[P.archive_gallery] ?? [] : [];
---
<Base title={site.business_name} description={P.seo_description} image={hero.id}>
  <section class="hero mapframe">
    <Img id={hero.id} alt={hero.cap} sizes="100vw" eager />
    {(P.hero_place || P.hero_coords) && <span class="coord tl">{P.hero_place && <span class="place">{P.hero_place}</span>}{P.hero_coords}</span>}
    <div class="wrap">
      <h1>{P.hero_heading}</h1>
      {P.hero_text && <p set:html={mdInline(P.hero_text)} />}
      <div class="actions">{P.hero_primary_label && <a class="btn" href="#departures">{P.hero_primary_label}</a>}{P.hero_secondary_label && <a class="btn ghost" href="/contact/">{P.hero_secondary_label}</a>}</div>
    </div>
  </section>

  <section class="band" id="departures">
    <div class="wrap">
      <div class="section-head"><h2>{P.departures_heading}</h2>{P.departures_link_label && <a href="/tours/">{P.departures_link_label}</a>}</div>
      <Departures />
      {P.departures_note && <p class="muted" style="margin-top:16px;font-size:1rem">{P.departures_note}</p>}
    </div>
  </section>

  {P.approach_heading && (
    <section class="band alt">
      <div class="wrap split">
        <div>
          <h2>{P.approach_heading}</h2>
        </div>
        <div>
          {P.approach_lede && <p class="lede">{P.approach_lede}</p>}
          {P.approach_body && <Fragment set:html={md(P.approach_body)} />}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap">
      <div class="section-head"><h2>{P.campaigns_heading}</h2></div>
      <Campaigns />
    </div>
  </section>

  {quotes.length > 0 && (
    <section class="band dark">
      <div class="wrap">
        <div class="section-head"><h2>{P.quotes_heading}</h2>{P.quotes_link_label && <a href="/testimonials/" style="color:#fff">{fill(P.quotes_link_label, { count: T.length })}</a>}</div>
        <div class="quotes3">{quotes.map((q) => <Quote t={q} max={330} />)}</div>
      </div>
    </section>
  )}

  {P.military_heading && (
    <section class="band">
      <div class="wrap split">
        <div>
          <h2>{P.military_heading}</h2>
          {P.military_text && <p>{P.military_text}</p>}
          {P.military_button && <a class="btn ghost" href="/military-battlefield-studies/">{P.military_button}</a>}
        </div>
        <div>
          {unitQuote && <Quote t={unitQuote} max={420} />}
        </div>
      </div>
    </section>
  )}

  {P.books.length > 0 && (
    <section class="band alt">
      <div class="wrap">
        <div class="section-head"><h2>{P.books_heading}</h2></div>
        {P.books_intro && <p class="lede" style="margin-bottom:32px" set:html={mdInline(P.books_intro)} />}
        <div class="books-pub">
          {P.books.map((b) => (
            <div><Img id={imageRef(b.image).id} alt={`Book cover: ${b.title}`} sizes="(max-width: 700px) 50vw, 25vw" /><h3>{b.title}</h3>{b.isbn && <p>{P.books_isbn_label} {b.isbn}</p>}</div>
          ))}
        </div>
      </div>
    </section>
  )}

  {strip.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div class="section-head"><h2>{P.archive_heading}</h2>{P.archive_link_label && <a href="/gallery/">{P.archive_link_label}</a>}</div>
        <Gallery items={strip} strip />
      </div>
    </section>
  )}
</Base>
