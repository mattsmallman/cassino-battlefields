---
import Base from '../layouts/Base.astro';
import Departures from '../components/Departures.astro';
import Campaigns from '../components/Campaigns.astro';
import { getPage } from '../lib/content';
const P = await getPage('toursPage');
---
<Base title={P.title || P.heading} description={P.seo_description}>
  <section class="band"><div class="wrap">
    <h1>{P.heading}</h1>
    {P.lede && <p class="lede">{P.lede}</p>}
    <div style="margin-top:40px"><Departures /></div>
  </div></section>
  <section class="band alt"><div class="wrap"><div class="section-head"><h2>{P.itineraries_heading}</h2></div><Campaigns /></div></section>
  {P.private_heading && (
    <section class="band"><div class="wrap split">
      <div><h2>{P.private_heading}</h2></div>
      <div>{P.private_text && <p class="lede">{P.private_text}</p>}{P.private_button && <a class="btn" href="/contact/?tour=Private%20group">{P.private_button}</a>}</div>
    </div></section>
  )}
</Base>
