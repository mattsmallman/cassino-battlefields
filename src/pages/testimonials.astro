---
import Base from '../layouts/Base.astro';
import T from '../data/testimonials.json';
const mil = T.filter((t) => t.military).length;
---
<Base title="Testimonials" description={`${T.length} testimonials from serving soldiers, veterans, families and historians who have toured the Italian battlefields with Frank de Planta.`}>
  <section class="band"><div class="wrap">
    <h1>What guests say</h1>
    <p class="lede">{T.length} accounts from people who have walked the ground with Frank: {mil} from serving units, the rest from families, veterans and enthusiasts.</p>
    <div class="chips" role="group" aria-label="Filter testimonials">
      <button type="button" data-f="all" aria-pressed="true">All</button>
      <button type="button" data-f="mil" aria-pressed="false">Military units</button>
      <button type="button" data-f="civ" aria-pressed="false">Private guests</button>
    </div>
    <div class="tcols">
      {T.map((t) => (
        <blockquote data-k={t.military ? 'mil' : 'civ'}><p>‘{t.quote}’</p><footer><b>{t.name}</b>{t.from}</footer></blockquote>
      ))}
    </div>
  </div></section>
  <script>
    const bs = document.querySelectorAll<HTMLButtonElement>('[data-f]');
    bs.forEach((b) => b.addEventListener('click', () => {
      bs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('.tcols blockquote').forEach((q) => { q.hidden = b.dataset.f !== 'all' && q.dataset.k !== b.dataset.f; });
    }));
  </script>
</Base>
