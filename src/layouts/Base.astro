---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';
import { getSettings, getTours, getWording } from '../lib/content';
import { metaFor } from '../lib/images';
import { cms } from '../lib/cms';
const S = (f: string) => cms('settings:site', f);
const site = await getSettings();
const footTours = await getTours();
interface Props { title: string; description: string; image?: string; }
const { title, description, image } = Astro.props;
const path = Astro.url.pathname;
const nav = site.navigation.map((n) => [n.link, n.label]);
const G = (await getWording()).general;
const full = title === site.business_name ? (site.home_title || site.business_name) : `${title} – ${site.business_name}`;
const canonical = new URL(path, Astro.site).href;
const om = image ? metaFor(image) : undefined;
const ogImg = image && om ? new URL(`/img/${image}-${om.sizes.includes(1280) ? 1280 : om.sizes[om.sizes.length - 1]}.webp`, Astro.site).href : undefined;
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImg && <meta property="og:image" content={ogImg} />}
  <meta name="theme-color" content="#007236" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main" {...cms('settings:wording', 'general.skip_link')}>{G.skip_link}</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/"><b {...S('business_name')}>{site.business_name}</b>{site.tagline && <span {...S('tagline')}>{site.tagline}</span>}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" {...cms('settings:wording', 'general.menu_button')}>{G.menu_button}</button>
      <nav class="nav" id="nav" aria-label={G.aria_main_nav}>
        {nav.map(([href, label], i) => (
          <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined} {...S(`navigation.${i}.label`)}>{label}</a>
        ))}
        {site.enquire_label && <a class="btn" href={site.enquire_link || '/contact/'} {...S('enquire_label')}>{site.enquire_label}</a>}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <h4 {...S('business_name')}>{site.business_name}</h4>
          {site.footer_blurb && <p {...S('footer_blurb')}>{site.footer_blurb}</p>}
          {site.addressLines.length > 0 && <p>{site.addressLines.join(', ')}</p>}
        </div>
        <div>
          <h4 {...S('footer_contact_heading')}>{site.footer_contact_heading}</h4>
          <ul>
            <li><a href={`mailto:${site.email}`} {...S('email')}>{site.email}</a></li>
            {site.phones.map((p) => <li><a href={p.href}>{p.short}</a></li>)}
            {site.facebook_url && <li><a href={site.facebook_url} rel="noopener">{G.footer_facebook}</a></li>}
          </ul>
        </div>
        <div>
          <h4 {...S('footer_tours_heading')}>{site.footer_tours_heading}</h4>
          <ul>
            {footTours.map((t) => <li><a href={`/${t.slug}/`} {...cms(`tours:${t.slug}`, 'name')}>{t.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="legal">© {site.company_name} {new Date().getFullYear()}.{site.company_number && ` Registered in England No ${site.company_number}.`}{site.footer_note && ` ${site.footer_note}`}</div>
    </div>
  </footer>
  <Lightbox />
  <script>
    // Inside the site editor's preview: load the live-preview bridge.
    if (new URLSearchParams(location.search).has('cms-preview')) import('../lib/preview-bridge');
  </script>
  <script>
    const b = document.querySelector('.menu-toggle')!; const n = document.getElementById('nav')!;
    b.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  </script>
</body>
</html>
